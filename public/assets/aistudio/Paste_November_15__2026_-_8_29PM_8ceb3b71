          ></textarea>
          <div class="flex flex-wrap items-center justify-between gap-3 pt-1">
            <span class="font-mono text-xs text-brand-accent">aryan.sawant@axion-intel.io</span>
            <button 
              type="submit" 
              class="px-6 py-2.5 rounded-full bg-brand-500 hover:bg-brand-400 text-black font-bold text-xs shadow-[0_0_20px_rgba(16,185,129,0.4)] transition-all cursor-pointer"
            >
              Transmit Message
            </button>
          </div>
        </form>
        <div id="contact-feedback" class="hidden p-3 rounded-xl bg-emerald-950/90 border border-brand-accent/50 text-brand-accent text-xs font-mono text-center">
          ✓ TRANSMISSION RECEIVED — ARYAN AMENDRA SAWANT WILL RESPOND SHORTLY.
        </div>
      </div>

    </div>
  </div>

  <script>
    // Initialize Lucide Icons
    lucide.createIcons();

    // ==========================================
    // 1. 60FPS DUAL-LAYER SPOTLIGHT MASK ENGINE
    // ==========================================
    const heroContainer = document.getElementById('hero-container');
    const maskLayer = document.getElementById('mask-layer');
    const spotlightHalo = document.getElementById('spotlight-halo');

    let targetX = window.innerWidth * 0.68;
    let targetY = window.innerHeight * 0.48;
    let currentX = targetX;
    let currentY = targetY;
    let isHovered = false;
    let spotlightRadius = window.innerWidth < 768 ? 105 : 150;

    function updateMask() {
      const maskStyle = `radial-gradient(circle ${spotlightRadius}px at ${currentX}px ${currentY}px, black 0%, rgba(0,0,0,0.85) 45%, rgba(0,0,0,0.3) 70%, transparent 100%)`;
      maskLayer.style.maskImage = maskStyle;
      maskLayer.style.webkitMaskImage = maskStyle;

      spotlightHalo.style.left = `${currentX}px`;
      spotlightHalo.style.top = `${currentY}px`;
      spotlightHalo.style.width = `${spotlightRadius * 2}px`;
      spotlightHalo.style.height = `${spotlightRadius * 2}px`;
    }

    function animateSpotlight() {
      const ease = isHovered ? 0.15 : 0.04;
      currentX += (targetX - currentX) * ease;
      currentY += (targetY - currentY) * ease;

      // Idle organic orbit when pointer is inactive
      if (!isHovered) {
        const time = Date.now() * 0.0012;
        const anchorX = window.innerWidth < 768 ? window.innerWidth * 0.65 : window.innerWidth * 0.70;
        targetX = anchorX + Math.cos(time) * 55;
        targetY = (window.innerHeight * 0.48) + Math.sin(time * 1.3) * 40;
      }

      updateMask();
      requestAnimationFrame(animateSpotlight);
    }

    heroContainer.addEventListener('mousemove', (e) => {
      targetX = e.clientX;
      targetY = e.clientY;
      isHovered = true;
    });

    heroContainer.addEventListener('mouseleave', () => {
      isHovered = false;
    });

    heroContainer.addEventListener('touchmove', (e) => {
      if (e.touches.length > 0) {
        targetX = e.touches[0].clientX;
        targetY = e.touches[0].clientY;
        isHovered = true;
      }
    }, { passive: true });

    heroContainer.addEventListener('touchend', () => {
      isHovered = false;
    });

    // ==========================================
    // 2. HTML5 FLOATING PARTICLES CANVAS
    // ==========================================
    const canvas = document.getElementById('particle-canvas');
    const ctx = canvas.getContext('2d');
    let particles = [];
    const particleCount = window.innerWidth < 768 ? 32 : 50;

    function resizeCanvas() {
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;
      spotlightRadius = window.innerWidth < 768 ? 105 : 150;
    }

    class CyberParticle {
      constructor() {
        this.reset();
      }
      reset() {
        this.x = Math.random() * canvas.width;
        this.y = Math.random() * canvas.height;
        this.size = Math.random() * 2.2 + 0.8;
        this.speedX = (Math.random() - 0.5) * 0.45;
        this.speedY = -Math.random() * 0.55 - 0.15;
        this.alpha = Math.random() * 0.65 + 0.2;
      }
      update() {
        this.x += this.speedX;
        this.y += this.speedY;
        if (this.y < -10 || this.x < -10 || this.x > canvas.width + 10) {
          this.reset();
          this.y = canvas.height + 10;
        }
      }
      draw() {
        ctx.save();
        ctx.beginPath();
        ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(0, 255, 157, ${this.alpha})`;
        ctx.shadowBlur = 10;
        ctx.shadowColor = '#00ff9d';
        ctx.fill();
        ctx.restore();
      }
    }

    function initParticles() {
      resizeCanvas();
      particles = [];
      for (let i = 0; i < particleCount; i++) {
        particles.push(new CyberParticle());
      }
    }

    function animateParticles() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      particles.forEach(p => {
        p.update();
        p.draw();
      });
      requestAnimationFrame(animateParticles);
    }

    window.addEventListener('resize', resizeCanvas);
    initParticles();
    animateParticles();
    animateSpotlight();

    // ==========================================
    // 3. WEB AUDIO SYNTHESIZER (TACTILE FEEDBACK)
    // ==========================================
    let audioCtx = null;
    let audioEnabled = false;
    const soundToggleBtn = document.getElementById('sound-toggle');
    const soundIcon = document.getElementById('sound-icon');

    function playCyberTone(freq = 520, duration = 0.08, type = 'sine') {
      if (!audioEnabled) return;
      if (!audioCtx) {
        audioCtx = new (window.AudioContext || window.webkitAudioContext)();
      }
      if (audioCtx.state === 'suspended') audioCtx.resume();

      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      osc.type = type;
      osc.frequency.setValueAtTime(freq, audioCtx.currentTime);
      osc.frequency.exponentialRampToValueAtTime(freq * 1.35, audioCtx.currentTime + duration);

      gain.gain.setValueAtTime(0.06, audioCtx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + duration);

      osc.connect(gain);
      gain.connect(audioCtx.destination);
      osc.start();
      osc.stop(audioCtx.currentTime + duration);
    }

    soundToggleBtn.addEventListener('click', () => {
      audioEnabled = !audioEnabled;
      soundIcon.setAttribute('data-lucide', audioEnabled ? 'volume-2' : 'volume-x');
      lucide.createIcons();
      if (audioEnabled) playCyberTone(640, 0.14, 'triangle');
    });

    document.querySelectorAll('[data-sound="hover"]').forEach(el => {
      el.addEventListener('mouseenter', () => playCyberTone(480, 0.05, 'sine'));
    });

    document.querySelectorAll('[data-sound="click"]').forEach(el => {
      el.addEventListener('click', () => playCyberTone(720, 0.1, 'triangle'));
    });

    // ==========================================
    // 4. MOBILE MENU & PROFILE DOSSIER MODAL
    // ==========================================
    const mobileMenuBtn = document.getElementById('mobile-menu-btn');
    const mobileDrawer = document.getElementById('mobile-drawer');
    const menuIcon = document.getElementById('menu-icon');
    let mobileMenuOpen = false;

    function closeMobileMenu() {
      mobileMenuOpen = false;
      mobileDrawer.classList.add('hidden');
      mobileDrawer.classList.remove('flex');
      menuIcon.setAttribute('data-lucide', 'menu');
      lucide.createIcons();
    }

    mobileMenuBtn.addEventListener('click', () => {
      mobileMenuOpen = !mobileMenuOpen;
      if (mobileMenuOpen) {
        mobileDrawer.classList.remove('hidden');
        mobileDrawer.classList.add('flex');
        menuIcon.setAttribute('data-lucide', 'x');
      } else {
        closeMobileMenu();
      }
      lucide.createIcons();
      playCyberTone(580, 0.08, 'triangle');
    });

    const profileModal = document.getElementById('profile-modal');

    function openProfileModal(tab = 'about') {
      profileModal.classList.remove('hidden');
      profileModal.classList.add('flex');
      switchModalTab(tab);
      playCyberTone(660, 0.12, 'triangle');
    }

    function closeProfileModal() {
      profileModal.classList.add('hidden');
      profileModal.classList.remove('flex');
      playCyberTone(420, 0.08, 'sine');
    }

    function switchModalTab(tab) {
      ['about', 'work', 'contact'].forEach(key => {
        const content = document.getElementById(`content-${key}`);
        const btn = document.getElementById(`tab-${key}`);
        if (key === tab) {
          content.classList.remove('hidden');
          btn.className = 'px-4 py-1.5 rounded-full text-xs font-semibold transition-all bg-brand-500 text-black';
        } else {
          content.classList.add('hidden');
          btn.className = 'px-4 py-1.5 rounded-full text-xs font-semibold transition-all bg-white/5 text-slate-300 hover:text-white';
        }
      });
    }

    function handleContactSubmit(e) {
      e.preventDefault();
      playCyberTone(820, 0.16, 'triangle');
      const feedback = document.getElementById('contact-feedback');
      feedback.classList.remove('hidden');
      e.target.reset();
    }

    // Close modal when clicking backdrop
    profileModal.addEventListener('click', (e) => {
      if (e.target === profileModal) closeProfileModal();
    });
  </script>
</body>
</html>