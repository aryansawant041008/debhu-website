<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>AXION | Aryan Amendra Sawant — Cyber-Ancient Intelligence</title>
  
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Syne:wght@500;700;800&display=swap" rel="stylesheet">
  
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>

  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            syne: ['Syne', 'sans-serif'],
            sans: ['Plus Jakarta Sans', 'sans-serif'],
          },
          colors: {
            brand: {
              accent: '#00ff9d',
              500: '#10b981',
              400: '#34d399',
              950: '#022c22',
            }
          }
        }
      }
    }
  </script>

  <style>
    * {
      box-sizing: border-box;
      user-select: none;
    }

    body, html {
      margin: 0;
      padding: 0;
      width: 100%;
      height: 100%;
      background-color: #000000;
      color: #ffffff;
      font-family: 'Plus Jakarta Sans', sans-serif;
      overflow: hidden;
    }

    /* Cyber Grid Overlay */
    .cyber-grid {
      background-size: 60px 60px;
      background-image: 
        linear-gradient(to right, rgba(16, 185, 129, 0.04) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(16, 185, 129, 0.04) 1px, transparent 1px);
    }

    /* Glassmorphism Capsules */
    .nav-capsule {
      background: rgba(8, 16, 12, 0.85);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(0, 255, 157, 0.25);
    }

    .glass-btn {
      background: rgba(0, 0, 0, 0.65);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.15);
      transition: all 0.3s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .glass-btn:hover {
      border-color: rgba(0, 255, 157, 0.6);
      box-shadow: 0 0 25px rgba(0, 255, 157, 0.2);
    }

    /* Statue Alignment */
    .statue-img {
      object-fit: cover;
      object-position: 75% center;
      opacity: 0.85;
      transition: opacity 0.3s ease;
    }

    @media (min-width: 768px) {
      .statue-img {
        object-position: right center;
        opacity: 1;
      }
    }

    /* Spotlight Follower Halo */
    #spotlight-halo {
      position: absolute;
      transform: translate(-50%, -50%);
      border-radius: 9999px;
      border: 2px solid rgba(0, 255, 157, 0.55);
      box-shadow: 
        0 0 40px rgba(0, 255, 157, 0.25),
        inset 0 0 30px rgba(0, 255, 157, 0.15);
      pointer-events: none;
      z-index: 4;
      transition: border-color 0.3s ease;
    }

    /* Animated Scroll Wheel */
    @keyframes scrollWheel {
      0% { transform: translateY(0); opacity: 1; }
      75% { transform: translateY(12px); opacity: 0.15; }
      100% { transform: translateY(0); opacity: 0; }
    }

    .scroll-wheel-dot {
      animation: scrollWheel 2s infinite ease-in-out;
    }

    /* Subtle Text Glow */
    .neon-text-glow {
      text-shadow: 0 0 30px rgba(0, 255, 157, 0.35);
    }

    /* Custom Scrollbar for Profile Modal */
    .modal-scroll::-webkit-scrollbar {
      width: 6px;
    }
    .modal-scroll::-webkit-scrollbar-track {
      background: rgba(0, 0, 0, 0.4);
    }
    .modal-scroll::-webkit-scrollbar-thumb {
      background: rgba(0, 255, 157, 0.35);
      border-radius: 9999px;
    }
  </style>
</head>
<body>

