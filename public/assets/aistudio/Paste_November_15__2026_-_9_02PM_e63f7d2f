  <style>
    * {
      box-sizing: border-box;
      user-select: none;
    }

    body, html {
      margin: 0;
      padding: 0;
      width: 100%;
      height: 100%;
      background-color: #030106;
      color: #ffffff;
      font-family: 'Plus Jakarta Sans', sans-serif;
      overflow: hidden;
    }

    /* Dark Violet & Lightning Cyan Cyber Grid */
    .cyber-grid {
      background-size: 60px 60px;
      background-image: 
        linear-gradient(to right, rgba(139, 92, 246, 0.06) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(0, 240, 255, 0.05) 1px, transparent 1px);
    }

    /* Dark Violet Glassmorphism Capsules */
    .nav-capsule {
      background: rgba(13, 6, 26, 0.86);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
      border: 1px solid rgba(139, 92, 246, 0.35);
      box-shadow: 0 8px 32px rgba(4, 1, 12, 0.8), inset 0 0 20px rgba(124, 58, 237, 0.12);
    }

    .glass-btn {
      background: rgba(11, 5, 22, 0.72);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid rgba(139, 92, 246, 0.3);
      transition: all 0.3s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .glass-btn:hover {
      border-color: rgba(0, 240, 255, 0.75);
      box-shadow: 0 0 25px rgba(0, 240, 255, 0.25), inset 0 0 12px rgba(124, 58, 237, 0.25);
    }

    /* Statue Alignment & Color Grading */
    .statue-img {
      object-fit: cover;
      object-position: 75% center;
      opacity: 0.85;
      transition: opacity 0.3s ease;
    }

    /* Shift the green cyber statue render into Electric Violet + Lightning Cyan */
    .statue-reveal-tint {
      filter: hue-rotate(85deg) saturate(1.45) brightness(1.08) contrast(1.08);
    }

    /* Subtle dark violet mood on base statue */
    .statue-base-tint {
      filter: saturate(0.85) contrast(1.06);
    }

    @media (min-width: 768px) {
      .statue-img {
        object-position: right center;
        opacity: 1;
      }
    }

    /* Lightning Cyan & Dark Violet Spotlight Halo */
    #spotlight-halo {
      position: absolute;
      transform: translate(-50%, -50%);
      border-radius: 9999px;
      border: 2px solid rgba(0, 240, 255, 0.65);
      box-shadow: 
        0 0 45px rgba(0, 240, 255, 0.35),
        0 0 80px rgba(124, 58, 237, 0.35),
        inset 0 0 35px rgba(0, 240, 255, 0.18);
      pointer-events: none;
      z-index: 4;
      transition: border-color 0.3s ease;
    }

    /* Animated Scroll Wheel */
    @keyframes scrollWheel {
      0% { transform: translateY(0); opacity: 1; }
      75% { transform: translateY(12px); opacity: 0.15; }
      100% { transform: translateY(0); opacity: 0; }
    }

    .scroll-wheel-dot {
      animation: scrollWheel 2s infinite ease-in-out;
    }

    /* Lightning Cyan Text Glow */
    .cyan-text-glow {
      text-shadow: 0 0 28px rgba(0, 240, 255, 0.45), 0 0 12px rgba(124, 58, 237, 0.4);
    }

    /* Custom Scrollbar for Profile Modal */
