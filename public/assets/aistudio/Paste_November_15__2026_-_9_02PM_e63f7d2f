    .modal-scroll::-webkit-scrollbar-track {
      background: rgba(8, 3, 18, 0.6);
    }
    .modal-scroll::-webkit-scrollbar-thumb {
      background: linear-gradient(180deg, #00f0ff, #7c3aed);
      border-radius: 9999px;
    }
