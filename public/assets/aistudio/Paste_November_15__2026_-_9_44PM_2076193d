    // ==========================================
    // 2. 60FPS DUAL-LAYER SPOTLIGHT MASK ENGINE
    // ==========================================
    const heroContainer = document.getElementById('hero-container');
    const maskLayer = document.getElementById('mask-layer');
    const spotlightHalo = document.getElementById('spotlight-halo');

    let targetX = window.innerWidth * 0.72;
    let targetY = window.innerHeight * 0.48;
    let currentX = targetX;
    let currentY = targetY;
    let isHovered = false;
    let spotlightRadius = window.innerWidth < 768 ? 110 : 165;
    let lastGlitchScanTime = 0;

    function updateMask() {
      const maskStyle = `radial-gradient(circle ${spotlightRadius}px at ${currentX}px ${currentY}px, black 0%, rgba(0,0,0,0.88) 45%, rgba(0,0,0,0.35) 70%, transparent 100%)`;
      maskLayer.style.maskImage = maskStyle;
      maskLayer.style.webkitMaskImage = maskStyle;

      spotlightHalo.style.left = `${currentX}px`;
      spotlightHalo.style.top = `${currentY}px`;
      spotlightHalo.style.width = `${spotlightRadius * 2}px`;
      spotlightHalo.style.height = `${spotlightRadius * 2}px`;
    }

    function animateSpotlight() {
      const ease = isHovered ? 0.15 : 0.04;
      currentX += (targetX - currentX) * ease;
      currentY += (targetY - currentY) * ease;

      if (!isHovered) {
        const time = Date.now() * 0.0012;
        const anchorX = window.innerWidth < 768 ? window.innerWidth * 0.55 : window.innerWidth * 0.74;
        targetX = anchorX + Math.cos(time) * 60;
        targetY = (window.innerHeight * 0.48) + Math.sin(time * 1.3) * 45;
      }

      updateMask();
      requestAnimationFrame(animateSpotlight);
    }

    heroContainer.addEventListener('mousemove', (e) => {
      const dx = e.clientX - targetX;
      const dy = e.clientY - targetY;
      const speed = Math.hypot(dx, dy);

      // Trigger subtle hologram scan glitch audio on rapid cursor sweeps
      const now = Date.now();
      if (speed > 42 && now - lastGlitchScanTime > 260) {
        playGlitchSFX('light');
        lastGlitchScanTime = now;
      }

      targetX = e.clientX;
      targetY = e.clientY;
      isHovered = true;
    });

    heroContainer.addEventListener('mouseleave', () => {
      isHovered = false;
    });

    heroContainer.addEventListener('touchmove', (e) => {
      if (e.touches.length > 0) {
        targetX = e.touches[0].clientX;
        targetY = e.touches[0].clientY;
        isHovered = true;
      }
    }, { passive: true });

    heroContainer.addEventListener('touchend', () => {
      isHovered = false;
    });

    // ==========================================
    // 3. HTML5 LIGHTNING CYAN & VIOLET PARTICLES
    // ==========================================
    const canvas = document.getElementById('particle-canvas');
    const ctx = canvas.getContext('2d');
    let particles = [];
    const particleCount = window.innerWidth < 768 ? 36 : 55;

    function resizeCanvas() {
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;
      spotlightRadius = window.innerWidth < 768 ? 110 : 165;
    }

    class CyberParticle {
      constructor() {
        this.reset();
      }
      reset() {
        this.x = Math.random() * canvas.width;
        this.y = Math.random() * canvas.height;
        this.size = Math.random() * 2.3 + 0.8;
        this.speedX = (Math.random() - 0.5) * 0.45;
        this.speedY = -Math.random() * 0.55 - 0.15;
        this.alpha = Math.random() * 0.75 + 0.25;
        this.isCyan = Math.random() > 0.35;
      }
      update() {
        this.x += this.speedX;
        this.y += this.speedY;
        if (this.y < -10 || this.x < -10 || this.x > canvas.width + 10) {
          this.reset();
          this.y = canvas.height + 10;
        }
      }
      draw() {
        ctx.save();
        ctx.beginPath();
        ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
        if (this.isCyan) {
          ctx.fillStyle = `rgba(0, 240, 255, ${this.alpha})`;
          ctx.shadowColor = '#00f0ff';
        } else {
          ctx.fillStyle = `rgba(167, 139, 250, ${this.alpha})`;
          ctx.shadowColor = '#8b5cf6';
        }
        ctx.shadowBlur = 12;
        ctx.fill();
        ctx.restore();
      }
    }

    function initParticles() {
      resizeCanvas();
      particles = [];
      for (let i = 0; i < particleCount; i++) {
        particles.push(new CyberParticle());
      }
    }

    function animateParticles() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      particles.forEach(p => {
        p.update();
        p.draw();
      });
      requestAnimationFrame(animateParticles);
    }

    window.addEventListener('resize', resizeCanvas);
    initParticles();
    animateParticles();
    animateSpotlight();

